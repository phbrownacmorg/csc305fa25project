extends layout

block content
  h1= title
  if formdata.HR_page
    p Welcome to the HR page, where we know what's good for you.
  else
    p Welcome to #{title}

  form#mainform(action="/", method="get")
    fieldset
      legend Next page
      if formdata.HR_page
        input#HR_page(type="checkbox", name="HR_page", checked)
      else
        input#HR_page(type="checkbox", name="HR_page")
      label Go to the HR page
    fieldset
      legend Courses by term
      if termslist
        label List courses for:&nbsp;
        select#term_year(name="term_year")
          option(value="") &mdash;Please select a term and year&mdash;
          each row in termslist
            - let term = row.OffTerm[0] + row.OffTerm.substring(1).toLowerCase()
            - let val = `${row.OffTerm}_${row.OffYear}`
            if formdata.term_year && (formdata.term_year == val)
              option(value=val, selected) #{term} #{row.OffYear}
            else
              option(value=val) #{term} #{row.OffYear}
      
      if termcourses && termcourses.length > 0
        table(class="courses")
          caption
            - let parts = formdata.term_year.split('_')
            - let term = parts[0]
            - let year = parts[1]
            h3 Courses offered in #{term[0]}#{term.substring(1).toLowerCase()} #{year}
          thead
            tr 
              //- th #{JSON.stringify(termcourses)}
              each key in Object.keys(termcourses[0])
                if key == "FacSSN"
                  th(scope="column", class="offerings") Instructor
                else
                  th(scope="column", class="offerings")= key
          tbody 
            each course in termcourses
              tr 
                each key in Object.keys(course)
                  if facpeople && (key == "FacSSN")
                    td(class="offerings")
                      - let select_id = `Offer${course['OfferNo']}_FacSSN`
                      select(id=select_id, name=select_id, class='name')
                        option(value='') 
                        each row in facpeople
                          if course.FacSSN == row.FacSSN
                            option(value=row.FacSSN,class='name',selected) #{row.FacFirstName.toLowerCase()} #{row.FacLastName.toLowerCase()}
                          else 
                            option(value=row.FacSSN,class='name') #{row.FacFirstName.toLowerCase()} #{row.FacLastName.toLowerCase()}

                  else
                    td(class="offerings") #{course[key]}

    fieldset
      legend Cubes
      label Show table of cubes up to
      - let top_cube = formdata.cube_n ? formdata.cube_n : 0
      input#cube_n(type="number", name="cube_n", value=top_cube)
      br
      if formdata.cube_n && formdata.cube_n > 0
        - let i = 1
        table(class="cubes")
          caption 
            h3 Table of cubes
          tr
            th n
            th n**3
          
          while i <= formdata.cube_n
            tr
              td #{i}
              td #{i**3}
            - i = i+1

    input(type="submit", value="Submit")

  if formdata.HR_page && faculty && faculty.length > 0
    - let departments = ['FIN','MS'];
    - let ranks = ['ASST', 'ASSC', 'PROF'];
    table
      caption
        h2 Faculty 
      thead
        tr
          each key in Object.keys(faculty[0])
            th(scope='column', class='facdetails') #{key}
          th(scope='column', class='facdetails') Delete?
      tbody 
        each row in faculty
          tr
            form(action="/", method="get")
              input(type="hidden",name="action",value=`faculty_update_${row.FacSSN}`)
              each key in Object.keys(formdata)
                if key != 'action' && key != 'FacDelete' && (!(key in row))
                  input(type="hidden",name=`${key}`, value=`${formdata[key]}`)

              td(class="facdetails") #{row.FacSSN}
                input(type="hidden",name="FacSSN", value=row.FacSSN) 
              td(class="facdetails") #{row.FacFirstName}
                input(type="hidden",name="FacFirstName", value=row.FacFirstName)
              td(class="facdetails") #{row.FacLastName}
                input(type="hidden",name="FacLastName", value=row.FacLastName)
              td(class="facdetails")
                input(type="text",name="FacCity", value=row.FacCity,style="width: 8em; text-align: center",required)
                span(class='flag')
              td(class="facdetails")
                input(type="text",name="FacState", value=row.FacState, style="width: 1.6em", pattern='[A-Z]{2}',required)
                span(class='flag')
              td(class="facdetails")
                select(name='FacDept',required)
                  each dept in departments
                    if dept == row.FacDept
                      option(selected) #{dept}
                    else 
                      option #{dept}
              td(class="facdetails")
                select(name='FacRank',required)
                  each rank in ranks
                    if rank == row.FacRank
                      option(selected) #{rank}
                    else 
                      option #{rank}
              td(class="facdetails")
                input(name="FacSalary",type="number",min="0",step="1000",value=row.FacSalary,style="width: 4.8em; text-align: right",required)
                span(class='flag')
              td(class="facdetails")
                select(name='FacSupervisor')
                  option(value='') 
                  each row2 in faculty
                    - let firstname = row2.FacFirstName[0] + row2.FacFirstName.substring(1).toLowerCase()
                    - let lastname = row2.FacLastName[0] + row2.FacLastName.substring(1).toLowerCase()
                    if row2.FacSSN == row.FacSupervisor
                      option(value=row2.FacSSN,selected) #{firstname} #{lastname}
                    else 
                      option(value=row2.FacSSN) #{firstname} #{lastname}
              td(class="facdetails") #{row.FacHireDate}
                input(type="hidden",name="FacHireDate", value=row.FacHireDate) 
              td(class="facdetails")
                input(type="text",name="FacZipCode", value=row.FacZipCode, pattern="\\d{9}",  style="width: 5em",required)
                span(class='flag')
              td(class='facdetails')
                input(type='checkbox',name="FacDelete")
              td(class="facdetails")
                input(type="submit",value="Update")
        tr
          form#faculty_insert(action="/", method="get")
            input(type="hidden",name="action",value='faculty_insert')
            //- Include the old formdata, so the main form redisplays correctly
            each key in Object.keys(formdata)
              if key != "action" && key != 'FacDelete' && (!(key in faculty[0]))
                input(type="hidden",name=`${key}`, value=`${formdata[key]}`)
            td(class="facdetails")
              input(name="FacSSN",type="text",pattern="\\d{9}",style="width: 5em",required)
              span(class='flag')
            td(class="facdetails")
              input(name="FacFirstName",type="text",style="width: 8em",required)
              span(class='flag')
            td(class="facdetails")
              input(name="FacLastName",type="text",style="width: 8em",required)
              span(class='flag')
            td(class="facdetails")
              input(name="FacCity",type="text",style="width: 8em",required)
              span(class='flag')
            td(class="facdetails")
              input(name="FacState",type="text",style="width: 1.6em", pattern='[A-Z]{2}',required)
              span(class='flag')
            td(class="facdetails")
              select(name='FacDept',required)
                each dept in departments
                  option #{dept}
            td(class="facdetails")
              select(name='FacRank',required)
                each rank in ranks
                  option #{rank}
            td(class="facdetails")
              input(name="FacSalary",type="number",min="0",step="1000",value="0",style="width: 4.8em; text-align: right",required)
              span(class='flag')
            td(class="facdetails")
              select(name='FacSupervisor')
                option(value='') 
                each row in faculty
                  - let firstname = row.FacFirstName[0] + row.FacFirstName.substring(1).toLowerCase()
                  - let lastname = row.FacLastName[0] + row.FacLastName.substring(1).toLowerCase()
                  option(value=row.FacSSN) #{firstname} #{lastname}
            td(class='facdetails')
              input(name='FacHireDate',type="date",style="width: 8em",required)
              span(class='flag')
            td(class="facdetails")
              input(name="FacZipCode",type="text",pattern="\\d{9}",style="width: 5em",required)
              span(class='flag')
            td(class='facdetails') &nbsp;
            td(class='facdetails')
              input(type="submit",value="Insert")

            